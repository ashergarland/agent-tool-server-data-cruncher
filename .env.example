# Service
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-data-cruncher
SERVICE_VERSION=0.1.0
GIT_SHA=unknown
PUBLIC_BASE_URL=

# Authentication. Development only: production rejects disabled authentication.
AUTH_MODE=disabled
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Requests per window per address before authentication runs.
PRE_AUTH_RATE_LIMIT_MAX=60

# Local file access. Defaults to enabled outside production; production requires an explicit
# opt-in and absolute roots.
LOCAL_PATHS_ENABLED=true
DATA_ROOT=.
# Optional comma-separated list; overrides DATA_ROOT when set.
DATA_ROOTS=

# Hosted asset storage: disabled | filesystem (development) | azure-blob (production)
ASSET_STORE=disabled
ASSET_FS_ROOT=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_CLIENT_ID=
ASSET_MAX_BYTES=
ASSET_TTL_SECONDS=86400
ASSET_QUOTA_BYTES=1073741824
ASSET_QUOTA_COUNT=100

# Execution limits
MAX_FILE_BYTES=67108864
MAX_FILTER_LENGTH=4096
MAX_PATTERN_LENGTH=1024
SUBPROCESS_TIMEOUT_MS=15000
MAX_OUTPUT_BYTES=1048576
DEFAULT_OUTPUT_BYTES=131072
MAX_MATCHES=1000
MAX_LINE_LENGTH=2000
TOOL_CONCURRENCY=2
TOOL_QUEUE_LIMIT=32
UPLOAD_CONCURRENCY=4
SHUTDOWN_GRACE_MS=10000
# Scratch space for child processes and materialised assets. Defaults to the system temp dir.
TEMP_DIR=

# Optional absolute paths to the binaries; resolved from PATH when unset.
JQ_PATH=
RIPGREP_PATH=
